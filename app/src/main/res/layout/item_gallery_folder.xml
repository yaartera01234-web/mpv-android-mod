<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/gallery_tile_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="9dp">

    <FrameLayout
        android:layout_width="86dp"
        android:layout_height="58dp">

        <View
            android:id="@+id/st3"
            android:layout_width="78dp"
            android:layout_height="50dp"
            android:layout_gravity="bottom|start"
            android:background="@drawable/gallery_stack_layer" />

        <View
            android:id="@+id/st2"
            android:layout_width="78dp"
            android:layout_height="50dp"
            android:layout_gravity="bottom|start"
            android:background="@drawable/gallery_stack_layer" />

        <View
            android:id="@+id/st1"
            android:layout_width="78dp"
            android:layout_height="50dp"
            android:layout_gravity="bottom|start"
            android:background="@drawable/gallery_stack_layer" />

        <TextView
            android:id="@+id/gCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:background="@drawable/gallery_count_badge"
            android:paddingStart="7dp"
            android:paddingTop="1dp"
            android:paddingEnd="7dp"
            android:paddingBottom="1dp"
            android:textColor="#FF170F26"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/gName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/home_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/gSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/g_text_dim2"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/gAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="›"
        android:textColor="@color/g_text_dim2"
        android:textSize="17sp" />
</LinearLayout>
